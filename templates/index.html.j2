<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ profile.name }} — Portfolio</title>
<meta name="description" content="{{ profile.tagline }}">
<link rel="stylesheet" href="assets/css/style.css">
<link rel="icon" href="data:,">
</head>
<body>

<header class="hero">
  <div class="container hero-inner">
    <p class="eyebrow">Portfolio</p>
    <h1>{{ profile.name }}</h1>
    <p class="tagline">{{ profile.tagline }}</p>
    <p class="bio">{{ profile.bio }}</p>
    <div class="links">
      <a href="mailto:{{ profile.email }}">Email</a>
      <a href="{{ profile.github }}" target="_blank" rel="noopener">GitHub</a>
      <a href="{{ profile.linkedin }}" target="_blank" rel="noopener">LinkedIn</a>
      <a href="{{ profile.cv_pdf }}" target="_blank" rel="noopener">Download CV</a>
    </div>
  </div>
</header>

<nav class="tabs container">
  <a href="#projects">Projects</a>
  <a href="#cv">CV</a>
</nav>

<main class="container">

  <section id="projects">
    <h2>Projects</h2>
    <div class="project-grid">
      {% for p in projects %}
      <article class="project-card">
        <a href="{{ p.hero_img }}" target="_blank" rel="noopener">
          <img src="{{ p.hero_img }}" alt="{{ p.hero_caption }}" loading="lazy">
        </a>
        <figcaption class="img-caption">{{ p.hero_caption }}</figcaption>
        <div class="project-body">
          <h3>{{ p.name }}</h3>
          <div class="tags">
            {% for t in p.tags %}<span class="tag">{{ t }}</span>{% endfor %}
          </div>
          <p class="summary">{{ p.summary }}</p>
          <ul class="results">
            {% for r in p.results %}<li>{{ r }}</li>{% endfor %}
          </ul>
          {% if p.secondary_img %}
          <a href="{{ p.secondary_img }}" target="_blank" rel="noopener">
            <img class="secondary-img" src="{{ p.secondary_img }}" alt="{{ p.secondary_caption }}" loading="lazy">
          </a>
          <figcaption class="img-caption">{{ p.secondary_caption }}</figcaption>
          {% endif %}
          <a class="repo-link" href="{{ p.repo }}" target="_blank" rel="noopener">View repository →</a>
        </div>
      </article>
      {% endfor %}
    </div>
  </section>

  <section id="cv">
    <h2>CV</h2>

    <div class="cv-block">
      <h3>Education</h3>
      {% for e in education %}
      <div class="cv-entry">
        <div class="cv-entry-head">
          <strong>{{ e.school }}</strong>
          <span class="period">{{ e.period }}</span>
        </div>
        <p class="degree">{{ e.degree }}</p>
        <ul>{% for d in e.details %}<li>{{ d }}</li>{% endfor %}</ul>
      </div>
      {% endfor %}
    </div>

    <div class="cv-block">
      <h3>Skills</h3>
      <div class="skills-grid">
        {% for group, items in skills.items() %}
        <div>
          <p class="skill-group">{{ group }}</p>
          <div class="tags">{% for i in items %}<span class="tag">{{ i }}</span>{% endfor %}</div>
        </div>
        {% endfor %}
      </div>
    </div>

    <div class="cv-block">
      <h3>Professional Experience</h3>
      {% for x in experience %}
      <div class="cv-entry">
        <div class="cv-entry-head">
          <strong>{{ x.role }}</strong>
          <span class="period">{{ x.period }}</span>
        </div>
        <p class="degree">{{ x.org }}{% if x.location %} · {{ x.location }}{% endif %}</p>
        <ul>{% for d in x.details %}<li>{{ d }}</li>{% endfor %}</ul>
      </div>
      {% endfor %}
    </div>

    <div class="cv-block">
      <h3>Awards</h3>
      <ul>{% for a in awards %}<li>{{ a }}</li>{% endfor %}</ul>
    </div>

    <div class="cv-block">
      <h3>Interests</h3>
      <ul>{% for i in interests %}<li>{{ i }}</li>{% endfor %}</ul>
    </div>

  </section>

</main>

<footer class="container">
  <p>&copy; {{ profile.name }}. Built with Python + Jinja2, generated statically for GitHub Pages.</p>
</footer>

</body>
</html>
